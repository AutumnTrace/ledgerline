{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Ledger": "Data Source=ledgerline.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "InitializeOnStartup": true
  },
  "Ledger": {
    "Concurrency": {
      "MaxRetries": 5,
      "BaseDelay": "00:00:00.010"
    }
  },
  "Messaging": {
    "Transport": "InMemory",
    "Topic": "ledger.entries.v1",
    "EnableRoundProjection": true,
    "Kafka": {
      "BootstrapServers": "localhost:9092",
      "ClientId": "ledgerline",
      "ConsumerGroup": "ledgerline-round-projector",
      "CreateTopic": true,
      "TopicPartitions": 3,
      "ReplicationFactor": 1
    }
  },
  "Outbox": {
    "Enabled": true,
    "PollingInterval": "00:00:00.250",
    "BatchSize": 100,
    "LagWarningThreshold": "00:00:30"
  }
}
